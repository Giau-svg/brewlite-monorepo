// Prisma schema file for BrewLite Backend
// Based on Assignment 2 Domain Class Diagram

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CUSTOMER
  STAFF
  MANAGER
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  REFUND
}

enum NotificationType {
  PAYMENT_SUCCESS
  ORDER_STATUS_UPDATED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  WALLET
  CARD
}

enum PaymentStatus {
  UNKNOWN
  PENDING
  SUCCESS
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model User {
  id                String               @id @default(uuid())
  fullName          String
  email             String               @unique
  phone             String?
  emailVerifiedAt   DateTime?
  isActive          Boolean              @default(true)
  authSessions      AuthSession[]
  emailVerification EmailVerification?
  passwordHash      String
  role              UserRole             @default(CUSTOMER)
  reservedPoints    Int                  @default(0)
  statusChanges     OrderStatusHistory[]
  requests          IdempotencyRecord[]
  loyaltyPoints     Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  orders              Order[]
  cart                Cart?
  notifications       Notification[]
  loyaltyTransactions LoyaltyTransaction[]

  @@map("users")
}

model LoyaltyTransaction {
  orderId      String?
  order        Order?                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  id           String                 @id @default(uuid())
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         LoyaltyTransactionType
  points       Int
  balanceAfter Int
  description  String?
  role         UserRole
  createdAt    DateTime               @default(now())

  @@unique([orderId, type])
  @@map("loyalty_transactions")
}

model Notification {
  orderId   String?
  order     Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  eventKey  String?          @unique
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  content   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notifications")
}

model Category {
  isActive Boolean   @default(true)
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id            String    @id @default(uuid())
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name          String
  description   String?
  basePrice     Decimal   @db.Decimal(10, 2)
  imageUrl      String?
  stockQuantity Int       @default(100)
  isAvailable   Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sizes      Size[]
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@map("products")
}

model Size {
  onHand      Int?
  reserved    Int         @default(0)
  isAvailable Boolean     @default(true)
  version     Int         @default(0)
  cartItems   CartItem[]
  orderItems  OrderItem[]
  id          String      @id @default(uuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  name        String
  extraPrice  Decimal     @default(0) @db.Decimal(10, 2)

  @@unique([id, productId])
  @@map("sizes")
}

model Topping {
  cartSelections CartItemTopping[]
  id             String            @id @default(uuid())
  name           String            @unique
  price          Decimal           @db.Decimal(10, 2)
  isAvailable    Boolean           @default(true)

  @@map("toppings")
}

model Cart {
  version   Int        @default(0)
  id        String     @id @default(uuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  sizeId                String?
  size                  Size?             @relation(fields: [sizeId, productId], references: [id, productId], onDelete: Restrict, onUpdate: Restrict)
  configurationKey      String?
  requiresConfiguration Boolean           @default(true)
  toppings              CartItemTopping[]
  id                    String            @id @default(uuid())
  cartId                String
  cart                  Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId             String
  product               Product           @relation(fields: [productId], references: [id])
  quantity              Int               @default(1)
  note                  String?

  @@unique([cartId, configurationKey])
  @@index([sizeId])
  @@map("cart_items")
}

model Order {
  isLegacy           Boolean              @default(true)
  expiresAt          DateTime?
  version            Int                  @default(0)
  promotionId        String?
  promotion          Promotion?           @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  couponCodeSnapshot String?
  reservation        OrderReservation?
  history            OrderStatusHistory[]
  transactions       LoyaltyTransaction[]
  notifications      Notification[]
  id                 String               @id @default(uuid())
  orderCode          String               @unique
  userId             String?
  user               User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  status             OrderStatus          @default(PENDING_PAYMENT)
  subtotal           Decimal              @db.Decimal(10, 2)
  discountAmount     Decimal              @default(0) @db.Decimal(10, 2)
  pointsUsed         Int                  @default(0)
  pointsDiscount     Decimal              @default(0) @db.Decimal(10, 2)
  finalTotal         Decimal              @db.Decimal(10, 2)
  note               String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  sizeId      String?
  size        Size?   @relation(fields: [sizeId, productId], references: [id, productId], onDelete: Restrict, onUpdate: Restrict)
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  sizeName    String?
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(10, 2)
  note        String?

  toppings OrderItemTopping[]

  @@index([sizeId])
  @@map("order_items")
}

model OrderItemTopping {
  id          String    @id @default(uuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  toppingName String
  price       Decimal   @db.Decimal(10, 2)

  @@map("order_item_toppings")
}

model Payment {
  attemptNumber     Int?
  providerPaymentId String?        @unique
  resolvedAt        DateTime?
  events            PaymentEvent[]
  id                String         @id @default(uuid())
  orderId           String
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount            Decimal        @db.Decimal(10, 2)
  method            PaymentMethod
  status            PaymentStatus  @default(PENDING)
  idempotencyKey    String?        @unique
  transactionRef    String?
  failureReason     String?
  createdAt         DateTime       @default(now())
  paidAt            DateTime?

  @@unique([orderId, attemptNumber])
  @@map("payments")
}

model Promotion {
  reservedCount Int          @default(0)
  orders        Order[]
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  maxDiscount   Decimal?     @db.Decimal(10, 2)
  minOrderValue Decimal?     @db.Decimal(10, 2)
  startDate     DateTime
  endDate       DateTime
  usageLimit    Int          @default(100)
  usedCount     Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())

  @@map("promotions")
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  sentAt    DateTime @default(now())
}

model AuthSession {
  familyId         String?
  refreshTokenHash String?      @unique
  refreshUsedAt    DateTime?
  parentId         String?      @unique
  parent           AuthSession? @relation("SessionRotation", fields: [parentId], references: [id])
  child            AuthSession? @relation("SessionRotation")
  id               String       @id @default(uuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime     @default(now())

  @@index([userId])
}

enum ReservationState {
  HELD
  CONSUMED
  RELEASED
}

model CartItemTopping {
  cartItemId String
  cartItem   CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  toppingId  String
  topping    Topping  @relation(fields: [toppingId], references: [id], onDelete: Restrict)

  @@id([cartItemId, toppingId])
  @@index([toppingId])
}

model OrderReservation {
  id             String           @id @default(uuid())
  orderId        String           @unique
  order          Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  state          ReservationState @default(HELD)
  pointsReserved Int              @default(0)
  createdAt      DateTime?
  updatedAt      DateTime?        @updatedAt
  expiresAt      DateTime
  consumedAt     DateTime?
  releasedAt     DateTime?

  @@index([state, expiresAt])
}

model OrderStatusHistory {
  id           String       @id @default(uuid())
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actorId      String?
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  fromStatus   OrderStatus?
  toStatus     OrderStatus
  orderVersion Int
  createdAt    DateTime     @default(now())

  @@unique([orderId, orderVersion])
  @@index([actorId])
}

model IdempotencyRecord {
  id               String                      @id @default(uuid())
  actorId          String
  actor            User                        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  operation        String
  key              String
  processingStatus IdempotencyProcessingStatus @default(SUCCEEDED)
  requestHash      String
  result           Json
  createdAt        DateTime                    @default(now())
  expiresAt        DateTime

  @@unique([actorId, operation, key])
  @@index([expiresAt])
}

model PaymentEvent {
  id               String                       @id @default(uuid())
  paymentId        String
  payment          Payment                      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  providerEventId  String                       @unique
  outcome          PaymentStatus
  amount           Decimal                      @db.Decimal(10, 2)
  receivedAt       DateTime                     @default(now())
  processedAt      DateTime?
  processingStatus PaymentEventProcessingStatus @default(RECEIVED)
  metadata         Json?

  @@index([paymentId, receivedAt])
}

enum IdempotencyProcessingStatus {
  IN_PROGRESS
  SUCCEEDED
  FAILED
}

enum PaymentEventProcessingStatus {
  RECEIVED
  PROCESSED
  REQUIRES_REVIEW
}
