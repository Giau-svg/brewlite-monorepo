# Cấu hình Database cho Docker (cổng 5433) hoặc Local (cổng 5432)
# Nếu dùng Docker compose:
DATABASE_URL="postgresql://brewlite_user:brewlite_password@localhost:5433/brewlite_db?schema=public"

# Cấu hình API Port
PORT=3001

# Cấu hình JWT
JWT_SECRET=
JWT_EXPIRES_IN="15m"

# Browser origin allowed to send authentication cookies
FRONTEND_ORIGIN=http://localhost:3000
# Gmail SMTP: enable 2-Step Verification and create an App Password.
# Store real values only in apps/api/.env, never commit them.
SMTP_USER=
SMTP_PASS=