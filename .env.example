# Cấu hình Database cho Docker (cổng 5433) hoặc Local (cổng 5432)
# Nếu dùng Docker compose:
DATABASE_URL="postgresql://brewlite_user:brewlite_password@localhost:5433/brewlite_db?schema=public"

# Cấu hình API Port
PORT=3001

# Cấu hình JWT
JWT_SECRET="super-secret-brewlite-key-change-in-production"
JWT_EXPIRES_IN="7d"
